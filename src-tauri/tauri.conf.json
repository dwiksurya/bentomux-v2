{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bentomux",
  "version": "0.1.0",
  "identifier": "app.bentomux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../out/renderer"
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../resources/bentomux-hook.cjs", "../resources/remote-page.html"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bentomux",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
